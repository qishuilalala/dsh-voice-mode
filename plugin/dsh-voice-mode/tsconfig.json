{
  "compilerOptions": {
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM"
    ],
    "strict": true,
    "noUnusedLocals": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true,
    "verbatimModuleSyntax": false,
    "types": [
      "node"
    ]
  },
  "include": [
    "src/ambient.d.ts",
    "src/sherpa-onnx-node.d.ts",
    "src/index.ts",
    "src/asr-host.ts",
    "src/tts-queue.ts",
    "src/tts-vits-worker.ts",
    "src/segmenter.ts"
  ],
  "exclude": [
    "src/client.tsx",
    "src/asr.ts",
    "node_modules"
  ]
}
