{
  "compilerOptions": {
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true,
    "verbatimModuleSyntax": false,
    "types": [
      "node",
      "react"
    ]
  },
  "include": [
    "src/client.tsx",
    "src/settings-form.tsx",
    "src/asr.ts",
    "src/aec.ts",
    "src/audio-worklet.ts"
  ],
  "exclude": [
    "src/index.ts",
    "src/asr-host.ts",
    "src/tts-queue.ts",
    "src/segmenter.ts",
    "node_modules"
  ]
}