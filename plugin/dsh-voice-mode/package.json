{
  "name": "dsh-voice-mode",
  "description": "Full-duplex voice mode for DeepSeek Harness: zipformer2 streaming ASR → editable draft, Edge TTS sentence-by-sentence read-aloud with live captions, true barge-in — on-device ASR, no API key. · DSH 语音双工对话：流式识别入草稿、按句朗读+实时字幕、开口即打断，识别本地推理、无需 API Key",
  "version": "0.1.5",
  "type": "module",
  "main": "lib/index.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/qishuilalala/dsh-voice-mode.git"
  },
  "homepage": "https://github.com/qishuilalala/dsh-voice-mode#readme",
  "bugs": {
    "url": "https://github.com/qishuilalala/dsh-voice-mode/issues"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "cordis.patch.yml",
    "assets/architecture.svg",
    "assets/demo.gif",
    "scripts/prefetch.mjs",
    "scripts/list-voices.mjs",
    "README.md",
    "README.en.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node build.mjs",
    "prepack": "node build.mjs",
    "test": "node test/segmenter.test.mjs && node test/wakeword.test.mjs && node test/verify-client.mjs",
    "verify:client": "node test/verify-client.mjs",
    "prefetch": "node scripts/prefetch.mjs",
    "list-voices": "node scripts/list-voices.mjs",
    "verify": "node scripts/verify.mjs",
    "typecheck": "node node_modules/typescript/bin/tsc -p tsconfig.json --noEmit && node node_modules/typescript/bin/tsc -p tsconfig.client.json --noEmit"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-slots"
      ]
    }
  },
  "dependencies": {
    "msedge-tts": "^2.0.7",
    "sherpa-onnx": "^1.13.6",
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-web": "^0.1.0-rc.6 || ^0.1.1-rc.0",
    "react": "^18.2.0"
  },
  "devDependencies": {
    "esbuild": "^0.25.0",
    "typescript": "^5.9.2",
    "@types/node": "^26.0.0",
    "@types/react": "^19.0.0"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "voice",
    "speech",
    "asr",
    "tts",
    "duplex",
    "zipformer2",
    "msedge-tts"
  ],
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT"
}
