{
  "name": "dsh-voice-mode",
  "description": "Full-duplex voice mode for DeepSeek Harness: zipformer2 streaming ASR → editable draft, Edge TTS (default, fast) or local (VITS / Kokoro int8, privacy-first) read-aloud with live captions, true barge-in; hardened HTTP surface (loopback/origin/rate-limit) + model SHA256 pinning. · DSH 语音双工对话：流式识别入草稿、Edge 默认朗读或本地（VITS / Kokoro int8）朗读+实时字幕、开口即打断；HTTP 面安全加固。",
  "version": "0.5.0",
  "type": "module",
  "main": "lib/index.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/qishuilalala/dsh-voice-mode.git"
  },
  "homepage": "https://github.com/qishuilalala/dsh-voice-mode#readme",
  "bugs": {
    "url": "https://github.com/qishuilalala/dsh-voice-mode/issues"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/tts-vits-worker.cjs",
    "lib/client.js",
    "lib/sense-worker.mjs",
    "cordis.patch.yml",
    "assets/architecture.svg",
    "assets/demo.gif",
    "scripts/prefetch.mjs",
    "scripts/list-voices.mjs",
    "scripts/bench-asr.mjs",
    "scripts/verify.mjs",
    "README.md",
    "README.en.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node build.mjs",
    "prepack": "node build.mjs",
    "test": "node test/segmenter.test.mjs && node test/aec.test.mjs && node test/download.test.mjs && node test/endpoint.test.mjs && node test/resample.test.mjs && node test/sense-worker.test.mjs && node test/detect-route.test.mjs && node test/verify-client.mjs",
    "verify:client": "node test/verify-client.mjs",
    "prefetch": "node scripts/prefetch.mjs",
    "list-voices": "node scripts/list-voices.mjs",
    "bench-asr": "node scripts/bench-asr.mjs",
    "verify": "node scripts/verify.mjs",
    "typecheck": "node node_modules/typescript/bin/tsc -p tsconfig.json --noEmit && node node_modules/typescript/bin/tsc -p tsconfig.client.json --noEmit"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-slots"
      ]
    }
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.1",
    "msedge-tts": "^2.0.7",
    "sherpa-onnx": "^1.13.6",
    "sherpa-onnx-node": "1.13.6"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-web": "^0.1.0-rc.6 || ^0.1.1-rc.0",
    "react": "^18.2.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-host-webserver": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-llm": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-settings": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-system-prompt": "^0.1.1-rc.2",
    "@types/node": "^26.0.0",
    "@types/react": "^19.0.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.9.2"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "voice",
    "speech",
    "asr",
    "tts",
    "duplex",
    "zipformer2",
    "msedge-tts"
  ],
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT"
}
