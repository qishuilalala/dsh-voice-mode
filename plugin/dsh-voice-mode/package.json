{
  "name": "dsh-voice-mode",
  "description": "Voice plugin for DeepSeek Harness: local streaming speech recognition into editable drafts, sentence-by-sentence read-aloud with captions, and voice interruption. Edge online or local VITS/Kokoro TTS; host compatibility is bounded by engines.dsh.",
  "icon": "./icon.svg",
  "version": "0.7.38",
  "type": "module",
  "main": "lib/index.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/qishuilalala/dsh-voice-mode.git"
  },
  "homepage": "https://github.com/qishuilalala/dsh-voice-mode#readme",
  "bugs": {
    "url": "https://github.com/qishuilalala/dsh-voice-mode/issues"
  },
  "engines": {
    "node": ">=18.0.0",
    "dsh": ">=0.1.1-rc.2 <0.3.0-0"
  },
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/msedge-tts.cjs",
    "lib/tts-vits-worker.cjs",
    "lib/client.js",
    "lib/sense-worker.mjs",
    "cordis.patch.yml",
    "icon.svg",
    "locale/*.json",
    "assets/architecture.svg",
    "scripts/prefetch.mjs",
    "scripts/list-voices.mjs",
    "scripts/bench-asr.mjs",
    "scripts/verify.mjs",
    "scripts/check-anchors.mjs",
    "README.md",
    "README.en.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "SECURITY.md"
  ],
  "scripts": {
    "build": "node build.mjs",
    "check:lib-drift": "node scripts/check-lib-drift.mjs",
    "prepack": "node build.mjs",
    "test": "node scripts/run-tests.mjs",
    "verify:client": "node test/verify-client.mjs",
    "prefetch": "node scripts/prefetch.mjs",
    "list-voices": "node scripts/list-voices.mjs",
    "bench-asr": "node scripts/bench-asr.mjs",
    "bench:echo-gate": "node scripts/bench-echo-gate.mjs",
    "analyze:fixture": "node scripts/analyze-fixture.mjs",
    "verify": "node scripts/verify.mjs",
    "typecheck": "node node_modules/typescript/bin/tsc -p tsconfig.json --noEmit && node node_modules/typescript/bin/tsc -p tsconfig.client.json --noEmit",
    "check:anchors": "node scripts/check-anchors.mjs",
    "check:doc-anchors": "node scripts/check-doc-anchors.mjs",
    "typecheck:dual": "bash scripts/typecheck-dual.sh",
    "smoke:runtime": "bash scripts/smoke-runtime.sh",
    "verify:dual": "bash scripts/verify-dual.sh",
    "e2e:full": "bash scripts/full-e2e.sh",
    "check:root-manifest": "node scripts/check-root-manifest.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-cordis-client-runner",
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-settings-plugins"
      ]
    }
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.5",
    "sherpa-onnx": "^1.13.6",
    "sherpa-onnx-node": "1.13.6"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "react": "^18.2.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.5",
    "@deepseek-ai/dsh-host-webserver": "0.1.5-rc.3",
    "@deepseek-ai/dsh-llm": "0.1.5-rc.3",
    "@deepseek-ai/dsh-settings": "0.1.5-rc.1",
    "@deepseek-ai/dsh-system-prompt": "0.1.5-rc.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "esbuild": "^0.28.2",
    "msedge-tts": "^2.1.1",
    "playwright-core": "1.65.0",
    "typescript": "^5.9.2"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "voice",
    "voice-mode",
    "speech",
    "asr",
    "tts",
    "speech-to-text",
    "text-to-speech",
    "speech-recognition",
    "full-duplex",
    "duplex",
    "barge-in",
    "captions",
    "wake-word",
    "local-asr",
    "on-device",
    "zipformer2",
    "sensevoice",
    "kokoro",
    "msedge-tts",
    "chinese",
    "语音",
    "字幕",
    "打断",
    "中文",
    "本地识别"
  ],
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT"
}
