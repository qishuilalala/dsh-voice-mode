{
  "name": "dsh-voice-mode",
  "version": "0.7.42",
  "description": "Full-duplex voice plugin for DeepSeek Harness (DSH): local streaming ASR/STT, push-to-talk, sentence read-aloud TTS with live captions, and voice barge-in (Edge, OpenAI, MiMo, offline VITS/Kokoro). · DSH 全双工语音对话插件：本地流式语音识别输入、按住说话、逐句语音合成朗读、实时字幕与发声打断。",
  "license": "MIT",
  "type": "module",
  "main": "./plugin/dsh-voice-mode/lib/index.js",
  "exports": {
    ".": "./plugin/dsh-voice-mode/lib/index.js",
    "./client": "./plugin/dsh-voice-mode/lib/client.js",
    "./cordis.patch.yml": "./plugin/dsh-voice-mode/cordis.patch.yml",
    "./locale/*.json": "./plugin/dsh-voice-mode/locale/*.json",
    "./package.json": "./package.json"
  },
  "icon": "./plugin/dsh-voice-mode/icon.svg",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/qishuilalala/dsh-voice-mode.git"
  },
  "homepage": "https://github.com/qishuilalala/dsh-voice-mode#readme",
  "bugs": {
    "url": "https://github.com/qishuilalala/dsh-voice-mode/issues"
  },
  "engines": {
    "node": ">=18.0.0",
    "dsh": ">=0.1.1-rc.2 <0.3.0-0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "react": "^18.2.0"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "dsh-bundle",
    "deepseek",
    "deepseek-harness",
    "voice",
    "voice-mode",
    "voice-input",
    "voice-chat",
    "voice-assistant",
    "speech",
    "full-duplex",
    "push-to-talk",
    "dictation",
    "read-aloud",
    "barge-in",
    "wake-word",
    "captions",
    "live-captions",
    "on-device",
    "offline",
    "asr",
    "stt",
    "speech-to-text",
    "speech-recognition",
    "tts",
    "text-to-speech",
    "local-asr",
    "sherpa-onnx",
    "zipformer2",
    "sensevoice",
    "edge-tts",
    "msedge-tts",
    "vits",
    "kokoro",
    "openai-tts",
    "mimo",
    "语音",
    "语音模式",
    "语音输入",
    "语音对话",
    "语音识别",
    "语音转文字",
    "听写",
    "语音合成",
    "文字转语音",
    "朗读",
    "按住说话",
    "实时字幕",
    "字幕",
    "打断",
    "唤醒词",
    "离线语音",
    "本地识别"
  ],
  "dsh": {
    "bundle": {
      "patch": "./plugin/dsh-voice-mode/cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-cordis-client-runner",
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-settings-plugins"
      ]
    }
  },
  "scripts": {
    "prepublishOnly": "node -e \"console.error('不要在仓库根目录发布：npm 包在 plugin/dsh-voice-mode 下发布。'); process.exit(1)\""
  }
}
