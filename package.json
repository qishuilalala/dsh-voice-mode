{
  "name": "dsh-voice-mode",
  "version": "0.7.34",
  "description": "Voice plugin for DeepSeek Harness: local streaming speech recognition into editable drafts, sentence-by-sentence read-aloud with captions, and voice interruption. Edge online or local VITS/Kokoro TTS; host compatibility is bounded by engines.dsh.",
  "license": "MIT",
  "type": "module",
  "main": "./plugin/dsh-voice-mode/lib/index.js",
  "exports": {
    ".": "./plugin/dsh-voice-mode/lib/index.js",
    "./client": "./plugin/dsh-voice-mode/lib/client.js",
    "./cordis.patch.yml": "./plugin/dsh-voice-mode/cordis.patch.yml",
    "./locale/*.json": "./plugin/dsh-voice-mode/locale/*.json",
    "./package.json": "./package.json"
  },
  "icon": "./plugin/dsh-voice-mode/icon.svg",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/qishuilalala/dsh-voice-mode.git"
  },
  "homepage": "https://github.com/qishuilalala/dsh-voice-mode#readme",
  "engines": {
    "node": ">=18.0.0",
    "dsh": ">=0.1.1-rc.2 <0.3.0-0"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "voice",
    "voice-mode",
    "speech",
    "asr",
    "tts",
    "speech-to-text",
    "text-to-speech",
    "speech-recognition",
    "full-duplex",
    "barge-in",
    "captions",
    "local-asr",
    "on-device"
  ],
  "dsh": {
    "bundle": {
      "patch": "./plugin/dsh-voice-mode/cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-cordis-client-runner",
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-settings-plugins"
      ]
    }
  },
  "scripts": {
    "prepublishOnly": "node -e \"console.error('不要在仓库根目录发布：npm 包在 plugin/dsh-voice-mode 下发布。'); process.exit(1)\""
  }
}
