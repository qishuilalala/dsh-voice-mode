{
  "name": "dsh-voice-mode",
  "version": "0.7.33",
  "description": "Full-duplex voice plugin for DeepSeek Harness: local zipformer2 streaming ASR (no API key) → editable draft; Edge TTS or local VITS / Kokoro read-aloud with live captions; true barge-in; hardened HTTP surface + model SHA256 pinning; compatible with all dsh releases since 0.1.1-rc.2 (verified 0.1.1-rc.2 → 0.2.2-alpha.2).",
  "license": "MIT",
  "type": "module",
  "main": "./plugin/dsh-voice-mode/lib/index.js",
  "icon": "./plugin/dsh-voice-mode/icon.svg",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/qishuilalala/dsh-voice-mode.git"
  },
  "homepage": "https://github.com/qishuilalala/dsh-voice-mode#readme",
  "engines": {
    "node": ">=18.0.0",
    "dsh": ">=0.1.1-rc.2 <0.3.0-0"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "voice",
    "voice-mode",
    "speech",
    "asr",
    "tts",
    "speech-to-text",
    "text-to-speech",
    "speech-recognition",
    "full-duplex",
    "barge-in",
    "captions",
    "local-asr",
    "on-device"
  ],
  "dsh": {
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-cordis-client-runner",
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-settings-plugins"
      ]
    }
  },
  "scripts": {
    "prepublishOnly": "node -e \"console.error('不要在仓库根目录发布：npm 包在 plugin/dsh-voice-mode 下发布。'); process.exit(1)\""
  }
}
