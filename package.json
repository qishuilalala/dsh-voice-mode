{
  "name": "dsh-voice-mode",
  "version": "0.7.46",
  "description": "DSH 语音插件：本地流式语音识别输入、按住说话、回复朗读、实时字幕与发声打断（含 VITS/Kokoro/Edge/OpenAI/MiMo）。",
  "author": {
    "name": "qishuilalala",
    "url": "https://github.com/qishuilalala"
  },
  "license": "MIT",
  "type": "module",
  "main": "./plugin/dsh-voice-mode/lib/index.js",
  "types": "./plugin/dsh-voice-mode/lib/index.d.ts",
  "exports": {
    ".": "./plugin/dsh-voice-mode/lib/index.js",
    "./client": "./plugin/dsh-voice-mode/lib/client.js",
    "./cordis.patch.yml": "./plugin/dsh-voice-mode/cordis.patch.yml",
    "./locale/*.json": "./plugin/dsh-voice-mode/locale/*.json",
    "./package.json": "./package.json"
  },
  "icon": "./plugin/dsh-voice-mode/icon.svg",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/qishuilalala/dsh-voice-mode.git"
  },
  "homepage": "https://github.com/qishuilalala/dsh-voice-mode#readme",
  "bugs": {
    "url": "https://github.com/qishuilalala/dsh-voice-mode/issues"
  },
  "engines": {
    "node": ">=18.0.0",
    "dsh": ">=0.1.1-rc.2 <0.3.0-0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1 || ^4.2.0-alpha.1",
    "react": "^18.2.0"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "dsh-bundle",
    "deepseek-harness",
    "voice",
    "voice-assistant",
    "speech-to-text",
    "text-to-speech",
    "stt",
    "tts",
    "asr",
    "push-to-talk",
    "barge-in",
    "offline",
    "sherpa-onnx",
    "msedge-tts",
    "语音"
  ],
  "dsh": {
    "bundle": {
      "patch": "./plugin/dsh-voice-mode/cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-cordis-client-runner",
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-settings-plugins"
      ]
    }
  },
  "scripts": {
    "prepublishOnly": "node -e \"console.error('不要在仓库根目录发布：npm 包在 plugin/dsh-voice-mode 下发布。'); process.exit(1)\""
  }
}
